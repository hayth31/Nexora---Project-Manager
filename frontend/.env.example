# Nexora — local environment for Vite dev server
# Copy this to .env.local and fill in your values (never commit .env.local)

# When running locally, the Vite proxy forwards /api/* to the backend at :3001
VITE_API_URL=http://localhost:3001

# Production (Vercel): set this to your Railway backend URL in Vercel's env settings
# VITE_API_URL=https://your-railway-app.up.railway.app
